GESTIA_API_PORT=8080
GESTIA_WEB_PORT=4200
GESTIA_SQL_PORT=1433
GESTIA_SQL_DATABASE=db-gestia-dev
GESTIA_SQL_PASSWORD=Replace_with_a_local_password_2026!
GESTIA_JWT_SECRET=Replace_with_a_very_long_local_jwt_secret_2026_min_32_chars
GESTIA_BOOTSTRAP_ADMIN_EMAIL=admin@gestia.local
GESTIA_BOOTSTRAP_ADMIN_PASSWORD=GestIA.Local.2026!

# La clave del inicio de sesion con el que el BACKEND habla con SQL Server.
#
# No es sa, y esa es toda la idea: sa puede borrar la base, crear inicios de sesion y leer
# cualquier otra base del motor. La aplicacion solo necesita leer y escribir filas de la suya, y
# eso es lo unico que este usuario puede hacer. Las migraciones si corren como sa, porque son un
# paso controlado que se ejecuta a mano y necesita permisos de esquema.
#
# Ponle una distinta de GESTIA_SQL_PASSWORD. SQL Server exige mayuscula, minuscula, digito y
# simbolo.
GESTIA_APP_SQL_PASSWORD=Cambiala.Antes.De.Arrancar.2026!
